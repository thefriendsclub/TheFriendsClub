# ==============================================================================
# The Friends Club - Environment Configuration
# ==============================================================================

# Supabase Free PostgreSQL Database Configuration
# Find these credentials in your Supabase project dashboard:
# 1. Go to https://supabase.com/dashboard/project/_/settings/api
# 2. Copy the "Project URL" and paste as SUPABASE_URL
# 3. Copy the "service_role" (secret) key and paste as SUPABASE_SERVICE_ROLE_KEY
#    (IMPORTANT: The service role key bypasses Row Level Security and must ONLY
#     be kept here on the server. Never commit this file or expose it to client code.)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional: Public Anon Key (can be used if service role key is not configured)
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Node Server Environment
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# CSRF Protection: Allowed origin for state-modifying requests
# In production, set this to your exact live domain, e.g. https://thefriendsclub.org
APP_ORIGIN=http://127.0.0.1:3001

# Fallback Local SQLite Database Path (used if Supabase credentials are not provided)
DB_PATH=data/club.sqlite
